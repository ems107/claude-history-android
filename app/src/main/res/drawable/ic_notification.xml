<?xml version="1.0" encoding="utf-8"?>
<!--
  A status-bar icon is a silhouette: Android throws the colours away and tints
  what is left, so this is the trail alone — no tile, which up there would be a
  white rectangle with smudges in it.

  The fade survives because only the ALPHA channel is read: the two chevrons
  behind come through as a lighter tint rather than as another colour, which is
  the same reading as everywhere else by a different mechanism.

  Same drawing as the launcher icon at half its coordinates (the 48-unit source
  in docs/brand, halved onto the 24dp canvas a notification icon must use).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:pathData="M4,8 L7.5,12 L4,16"
        android:strokeAlpha="0.3"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.75" />
    <path
        android:pathData="M8.5,6.75 L13,12 L8.5,17.25"
        android:strokeAlpha="0.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3.25" />
    <path
        android:pathData="M13.25,5.5 L19.5,12 L13.25,18.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="3.75" />
</vector>
