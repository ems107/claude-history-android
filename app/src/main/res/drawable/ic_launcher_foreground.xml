<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a terminal prompt and the trail it leaves behind. The solid chevron
  is now; the two behind it are what already happened.

  Drawn on the 48-unit canvas the SVG sources use (docs/brand/icon-a.svg) and
  scaled into the 108dp foreground by a group transform, so the two can never
  drift apart. 1.65 rather than the obvious 1.5: the furthest ink then sits 30.9
  from the centre while Android's guaranteed-visible circle has a radius of 33,
  so the mark fills as much of the tile as it can without risking a mask.

  Warm near-black, not the app's cool one — on a terracotta ground a cool black
  goes muddy. The tile behind it is @color/ic_launcher_background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.65"
        android:scaleY="1.65"
        android:translateX="14.4"
        android:translateY="14.4">
        <path
            android:pathData="M8,16 L15,24 L8,32"
            android:strokeAlpha="0.28"
            android:strokeColor="#2B2320"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />
        <path
            android:pathData="M17,13.5 L26,24 L17,34.5"
            android:strokeAlpha="0.55"
            android:strokeColor="#2B2320"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="6.5" />
        <path
            android:pathData="M26.5,11 L39,24 L26.5,37"
            android:strokeColor="#2B2320"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="7.5" />
    </group>
</vector>
